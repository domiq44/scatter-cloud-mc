set terminal pngcairo size 1000,600 enhanced
set output output_file
set datafile separator ','
if (log_scale) {
	set logscale y 10
	set yrange [*:*]
	set ylabel 'Densité diffuse conditionnelle par unité μ (log)'
} else {
	unset logscale y
	set yrange [0:*]
	set ylabel 'Densité diffuse conditionnelle par unité μ'
}
if (cos_alpha_d) {
	x_column = 2
	set xlabel 'cos(α_d)'
	set xrange [-1:1]
} else {
	x_column = 1
	set xlabel 'Angle de diffusion α_d (degrés)'
	set xrange [0:180]
}
stats data_file using 11 nooutput
ballistic_fraction = STATS_mean
set title sprintf('Composante diffuse conditionnelle à la détection (θ₀ = %.0f°, τ = %.2f, faisceau direct = %.1f%%)', theta_zero, tau, 100.0 * ballistic_fraction)
set grid xtics ytics
set key top left
plot data_file using (column(x_column)):($9 > 0 ? $9 : 1/0):($9 > 0 ? ($9 > 2.0*$10 ? $9-$10 : $9) : 1/0):($9 > 0 ? $9+$10 : 1/0) with yerrorbars pt 0 lw 1 lc rgb '#777777' title 'Erreur-type (1σ)', data_file using (column(x_column)):($9 > 0 ? $9 : 1/0) with steps lw 2 lc rgb '#245b9e' title 'Après au moins une diffusion'